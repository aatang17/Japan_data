{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(pkill -f \"Google Chrome\"*)",
      "Bash(pkill -f 'Google Chrome'*)",
      "Bash(killall \"Google Chrome\"*)",
      "Bash(killall Google Chrome*)",
      "Bash(killall Chrome*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-browser-kill.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
